# ===========================================================================
# Smart Study Companion — Environment Configuration
# ===========================================================================
# Rename this file to ".env" and fill in your values.
# The application will read this from either the root folder or backend folder.

# Google Gemini API Key (obtained from Google AI Studio)
# Required only if using "Gemini" mode in the sidebar.
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Ollama Configuration (Local Offline Models)
# ---------------------------------------------------------------------------
# Base URL for local Ollama instance (default: http://127.0.0.1:11434)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Chat Model name (default: llama3.2:1b)
# OLLAMA_CHAT_MODEL=llama3.2:1b

# Embedding Model name (default: nomic-embed-text)
# OLLAMA_EMBED_MODEL=nomic-embed-text
